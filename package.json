{
  "name": "ai-footprint",
  "version": "1.0.0",
  "private": true,
  "description": "AI Footprint environmental intelligence platform",
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c green,cyan \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
